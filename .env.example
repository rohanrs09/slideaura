# ===========================================
# 🔒 Environment Variables Configuration
# ===========================================
# 
# IMPORTANT: Copy this file to .env.local (NOT .env)
# .env.local is ignored by git and more secure
# 
# NEVER commit your actual .env.local file!
# ===========================================

# 🛡️ Clerk Authentication
# Get your key from: https://dashboard.clerk.com/last-active?path=api-keys
# Format: pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_actual_clerk_publishable_key_here

# 🔥 Firebase Configuration
# Get your API key from: https://console.firebase.google.com/
# Go to Project Settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# 🖼️ ImageKit Configuration (Optional - for enhanced image generation)
# Get your keys from: https://imagekit.io/dashboard
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
# VITE_IMAGEKIT_AUTH_ENDPOINT=https://your-backend.com/imagekit-auth

# ===========================================
# 📋 Setup Instructions:
# 
# 1. Copy this file: cp .env.example .env.local
# 2. Replace placeholder values with your actual keys
# 3. Restart your development server
# 4. Never commit .env.local to git
# ===========================================
